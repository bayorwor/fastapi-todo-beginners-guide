# .env.example - a template showing which settings the app needs.
# Copy this file to ".env" and fill in your own values.
# This file IS committed to Git, so never put real secrets here.
APP_NAME=Todo API
APP_VERSION=1.0.0
APP_DESCRIPTION=A simple Todo API built with FastAPI for learning.

# MySQL connection (Laragon / XAMPP / WAMP default: user "root" with an empty password)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=todo_db
